{
  "files.eol": "\n",

  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "css.lint.unknownAtRules": "ignore",

  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "json.schemaDownload.enable": true,
  "editor.tabSize": 4,
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "[scss]": {
    "editor.tabSize": 2
  },
  "[sass]": {
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[prettierrc]": {
    "editor.tabSize": 2
  },
  "tailwindCSS.experimental.classRegex": [
    ["className=\\{([^}]+)\\}", "[\"'`]([^\"'`]*)[\"'`]"],
    "className=\\s*[\"'`]([^\"'`]*)[\"'`]"
  ]
}
